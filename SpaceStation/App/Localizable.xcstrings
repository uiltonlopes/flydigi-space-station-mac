            "value": "Trava do gatilho"
          }
        }
      }
    },
    "Trigger mode": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo do gatilho"
          }
        }
      }
    },
    "Trigger presets apply in XInput mode only.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets de gatilho valem só em modo XInput."
          }
        }
      }
    },
    "Trigger travel range for sustained breakthrough feedback.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faixa de curso em que o rompimento se mantém."
          }
        }
      }
    },
    "Trigger travel range for sustained vibration feedback.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faixa de curso em que a vibração se mantém."
          }
        }
      }
    },
    "Trigger travel required to activate breakthrough feedback.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
